generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model Link {
  id Int @id @default(autoincrement())
  code String @unique
  url String
  createdAt DateTime @default(now())
  clicks Click[]
}

model Click {
  id Int @id @default(autoincrement())
  linkId Int
  link Link @relation(fields: [linkId], references: [id])
  createdAt DateTime @default(now())
  referrer String?
  userAgent String?
}